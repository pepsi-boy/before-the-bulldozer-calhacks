# OCI auth uses the API signing key in ~/.oci/config (no GenAI API key needed)
OCI_REGION=us-chicago-1
OCI_MODEL_ID=meta.llama-4-maverick-17b-128e-instruct-fp8
# Optional: defaults to the tenancy OCID from ~/.oci/config
OCI_COMPARTMENT_ID=
OCI_CONFIG_PROFILE=DEFAULT
# Set to "false" to hide CO2 if the EPA WARM factors can't be defended
NEXT_PUBLIC_SHOW_CO2=true

# Apify: our "nashville-demolition-permits" Actor (apify-actor/)
APIFY_TOKEN=
# username~actor-name, e.g. omar~nashville-demolition-permits
APIFY_ACTOR_ID=
# Shared secret the Fetch.ai agents send as x-agent-key (optional, recommended when deployed)
AGENT_API_KEY=
